# ============================================================
# MEDIQUORY CONNECT — PRODUCTION ENV
# Copy this to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# --- Database ---
DB_USER=mediquory_user
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=mediquory_db

# --- Backend ---
NODE_ENV=production
PORT=5000
JWT_SECRET=GENERATE_WITH: openssl rand -base64 64
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=GENERATE_WITH: openssl rand -base64 32

# --- URLs (update with your domain) ---
FRONTEND_URL=https://mediquory.workhrishi.in
CORS_ORIGIN=https://mediquory.workhrishi.in

# --- Frontend (baked in at build time) ---
NEXT_PUBLIC_API_URL=https://mediquory-api.workhrishi.in/api
NEXT_PUBLIC_SOCKET_URL=https://mediquory-api.workhrishi.in
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
NEXT_PUBLIC_ENABLE_PATIENT_SIGNUP=false

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
RAZORPAY_KEY_SECRET=YOUR_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# --- Agora Video ---
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_CERTIFICATE

# --- Cloudinary (file storage) ---
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# --- Feature Flags ---
ENABLE_PATIENT_SIGNUP=false
